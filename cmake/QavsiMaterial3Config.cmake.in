@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.12 COMPONENTS Quick LabsStyleKit)
if(TARGET QavsiIcons::Core)
    # find_dependency can locate a new config without replacing an existing imported target.
    include("${CMAKE_CURRENT_LIST_DIR}/QavsiMaterial3IconsVersion.cmake")
    qavsi_material3_icons_version_error(_qavsi_material3_icons_error)
    if(_qavsi_material3_icons_error)
        set(QavsiMaterial3_FOUND FALSE)
        set(QavsiMaterial3_NOT_FOUND_MESSAGE "${_qavsi_material3_icons_error}")
        unset(_qavsi_material3_icons_error)
        return()
    endif()
    unset(_qavsi_material3_icons_error)
endif()
find_dependency(QavsiIcons 0.2 CONFIG COMPONENTS Core)
set_and_check(QavsiMaterial3_QML_IMPORT_DIR "@PACKAGE_qml_install_dir@")
include("${CMAKE_CURRENT_LIST_DIR}/QavsiMaterial3Targets.cmake")
# Generated qmldir linktargets also serve Qt's installed QML import scanner.
foreach(module IN ITEMS Theme Style)
    if(NOT TARGET QavsiMaterial3${module}Plugin)
        add_library(QavsiMaterial3${module}Plugin ALIAS QavsiMaterial3::${module}Plugin)
    endif()
endforeach()
check_required_components(QavsiMaterial3)
