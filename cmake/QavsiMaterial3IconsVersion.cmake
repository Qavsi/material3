function(qavsi_material3_icons_version_error result)
    get_target_property(version QavsiIcons::Core VERSION)
    if(NOT version)
        set(version "${QavsiIcons_VERSION}")
    endif()
    set(error "")
    if(NOT version OR version VERSION_LESS 0.2)
        set(error "QavsiMaterial3 requires Qavsi Icons 0.2 or later (resolved version: '${version}').")
    endif()
    set("${result}" "${error}" PARENT_SCOPE)
endfunction()
